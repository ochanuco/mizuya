{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mizuya",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	// 入口は Discord と GitHub からの署名つきリクエストと、Access を通った Working の接続だけなので、独自ドメインに絞る
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{
			"pattern": "mizuya.chanu.co",
			"custom_domain": true
		}
	],
	"durable_objects": {
		"bindings": [
			{ "name": "WORKING_INBOX", "class_name": "WorkingInbox" },
			{ "name": "APPROVAL_LEDGER", "class_name": "ApprovalLedger" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["WorkingInbox"] },
		{ "tag": "v2", "new_sqlite_classes": ["ApprovalLedger"] }
	],
	"observability": {
		"enabled": true
	}
}
