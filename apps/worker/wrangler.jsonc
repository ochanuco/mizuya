{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mizuya",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	// 入口は Discord と GitHub からの署名つきリクエストだけなので、独自ドメインに絞る
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{
			"pattern": "mizuya.chanu.co",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": true
	}
}
